apiVersion: maas.opendatahub.io/v1alpha1
kind: MaaSAuthPolicy
metadata:
  name: {{ model_namespace }}-{{ model_ref_name }}-access
  namespace: {{ tenant_namespace }}
spec:
  modelRefs:
  - name: {{ model_ref_name }}
    namespace: {{ model_namespace }}
  subjects:
    groups:
    - name: system:authenticated
    users: []

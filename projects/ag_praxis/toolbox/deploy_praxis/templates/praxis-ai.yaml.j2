admin:
  address: "0.0.0.0:9901"

insecure_options:
  allow_public_admin: true

listeners:
  - name: ai
    address: "0.0.0.0:8080"
    filter_chains: [rhoai]

filter_chains:
  - name: rhoai
    filters:
      - filter: router
        routes:
          - path_prefix: "{{ model_path }}/v1"
            cluster: rhoai_model
          - path_prefix: "{{ model_path }}/health"
            cluster: rhoai_model

      - filter: load_balancer
        clusters:
          - name: rhoai_model
{% if use_tls %}
            tls:
              sni: "{{ model_host }}"
              ca:
                ca_path: "/etc/praxis-ca/ca-bundle.crt"
{% else %}
            trusted_private_endpoints:
              - "{{ model_host }}"
{% endif %}
            endpoints:
              - "{{ model_endpoint }}"

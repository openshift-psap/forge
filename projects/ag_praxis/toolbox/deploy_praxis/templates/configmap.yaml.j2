apiVersion: v1
kind: ConfigMap
metadata:
  name: praxis-config
  namespace: {{ namespace }}
data:
  praxis-ai.yaml: |
    admin:
      address: "127.0.0.1:9901"

    listeners:
      - name: ai
        address: "0.0.0.0:8080"
        filter_chains: [rhoai]

    filter_chains:
      - name: rhoai
        filters:
          - filter: router
            routes:
              - path_prefix: "/v1"
                cluster: rhoai_model

          - filter: load_balancer
            clusters:
              - name: rhoai_model
                trusted_private_endpoints:
                  - "{{ model_host }}"
                endpoints:
                  - "{{ model_endpoint }}"

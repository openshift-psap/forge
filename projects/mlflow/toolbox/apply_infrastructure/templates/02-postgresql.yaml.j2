apiVersion: v1
kind: ConfigMap
metadata:
  name: postgresql-exporter-queries
  namespace: {{ namespace }}
data:
  queries.yaml: |
    pg_lock_waits:
      query: |
        SELECT wait_event, count(*) AS count
        FROM pg_stat_activity
        WHERE datname = 'mlflow' AND wait_event_type = 'Lock'
        GROUP BY wait_event
      metrics:
        - wait_event:
            usage: "LABEL"
            description: "Lock type a backend is currently waiting on"
        - count:
            usage: "GAUGE"
            description: "Number of backends currently blocked waiting on this lock type"
    pg_mlflow_backend_io:
      query: |
        SELECT COALESCE(SUM(write_bytes), 0) / current_setting('block_size')::bigint AS buffers_written_total
        FROM pg_stat_io
        WHERE object IN ('relation', 'temp relation')
          AND backend_type NOT IN ('background writer', 'checkpointer')
      metrics:
        - buffers_written_total:
            usage: "COUNTER"
            description: "Relation blocks written by backends other than the background writer and checkpointer"
    pg_mlflow_checkpointer:
      query: SELECT buffers_written AS buffers_written_total FROM pg_stat_checkpointer
      metrics:
        - buffers_written_total:
            usage: "COUNTER"
            description: "Shared buffers written during checkpoints and restartpoints"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgresql-pvc
  namespace: {{ namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 10Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgresql
  namespace: {{ namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgresql
  template:
    metadata:
      labels:
        app: postgresql
    spec:
      containers:
        - name: postgresql
          image: registry.redhat.io/rhel9/postgresql-18:latest
          env:
            - name: POSTGRESQL_USER
              valueFrom:
                secretKeyRef:
                  name: postgresql-credentials
                  key: POSTGRES_USER
            - name: POSTGRESQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgresql-credentials
                  key: POSTGRES_PASSWORD
            - name: POSTGRESQL_DATABASE
              valueFrom:
                secretKeyRef:
                  name: postgresql-credentials
                  key: POSTGRES_DB
            - name: POSTGRESQL_LIBRARIES
              value: "pg_stat_statements"
            - name: POSTGRESQL_EXTENSIONS
              value: "pg_stat_statements"
            - name: POSTGRESQL_EXTRA_ARGS
              value: >-
                -c track_io_timing=on
                -c track_wal_io_timing=on
                -c shared_preload_libraries=pg_stat_statements
          ports:
            - containerPort: 5432
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - pg_isready -h 127.0.0.1 -p 5432 -U "$POSTGRESQL_USER" -d "$POSTGRESQL_DATABASE"
            initialDelaySeconds: 2
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 60
          volumeMounts:
            - name: postgresql-storage
              mountPath: /var/lib/pgsql/data
        - name: postgres-exporter
          image: quay.io/prometheuscommunity/postgres-exporter:v0.17.0
          args:
            - "--extend.query-path=/etc/postgres-exporter/queries.yaml"
          env:
            - name: EXPORTER_USER
              valueFrom:
                secretKeyRef:
                  name: postgresql-exporter-credentials
                  key: EXPORTER_USER
            - name: EXPORTER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgresql-exporter-credentials
                  key: EXPORTER_PASSWORD
            - name: DATA_SOURCE_NAME
              value: "postgresql://$(EXPORTER_USER):$(EXPORTER_PASSWORD)@localhost:5432/mlflow?sslmode=disable"
          ports:
            - name: metrics
              containerPort: 9187
          volumeMounts:
            - name: exporter-queries
              mountPath: /etc/postgres-exporter
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
      volumes:
        - name: postgresql-storage
          persistentVolumeClaim:
            claimName: postgresql-pvc
        - name: exporter-queries
          configMap:
            name: postgresql-exporter-queries
---
apiVersion: v1
kind: Service
metadata:
  name: postgresql
  namespace: {{ namespace }}
  labels:
    app: postgresql
spec:
  selector:
    app: postgresql
  ports:
    - name: postgresql
      port: 5432
      targetPort: 5432
    - name: metrics
      port: 9187
      targetPort: 9187

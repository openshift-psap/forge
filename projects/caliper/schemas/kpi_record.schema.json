{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kpi_id",
    "run_id",
    "timestamp",
    "labels",
    "metadata",
    "is_curve",
    "name",
    "help"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "kpi_id": { "type": "string" },
    "name": { "type": "string" },
    "help": { "type": "string" },
    "value": { "type": ["number", "string", "null"] },
    "values": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "unit": { "type": "string" },
    "run_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "labels": { "type": "object" },
    "metadata": { "type": "object" },
    "higher_is_better": { "type": "boolean" },
    "is_curve": { "type": "boolean" },
    "x_unit": { "type": "string" },
    "x_help": { "type": "string" },
    "y_unit": { "type": "string" },
    "y_help": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "is_curve": { "const": false } } },
      "then": { "required": ["value"] },
      "else": { "required": ["values"] }
    },
    {
      "if": { "properties": { "is_curve": { "const": false } } },
      "then": { "required": ["unit"] },
      "else": { "required": ["x_unit", "y_unit"] }
    }
  ],
  "additionalProperties": false
}

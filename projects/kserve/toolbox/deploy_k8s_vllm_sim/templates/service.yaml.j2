---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: forge
    app: {{ name }}
{% if deployment_uid %}
  ownerReferences:
  - apiVersion: apps/v1
    kind: Deployment
    name: {{ name }}
    uid: {{ deployment_uid }}
{% endif %}
spec:
  type: ClusterIP
  selector:
    app: {{ name }}
  ports:
    - port: {{ port }}
      targetPort: http
      protocol: TCP
      name: http

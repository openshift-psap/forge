---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: forge
    app: {{ name }}
spec:
  type: ClusterIP
  selector:
    app: {{ name }}
  ports:
    - port: {{ port }}
      targetPort: http
      protocol: TCP
      name: http
